#ifndef VERSION_H
#define VERSION_H

#define APP_NAME "NanoVNA CLI Accessible"
#define APP_VERSION_MAJOR @VERSION_MAJOR@
#define APP_VERSION_MINOR @VERSION_MINOR@
#define APP_VERSION_PATCH @VERSION_PATCH@
#define APP_VERSION_SUFFIX "@VERSION_SUFFIX@"
#define APP_VERSION_STRING "@VERSION_STRING@"
#define APP_GIT_COMMIT "@GIT_COMMIT_HASH@"
#define APP_BUILD_TIMESTAMP "@BUILD_TIMESTAMP@"
#define APP_REPO_TYPE "@REPO_TYPE@"
#define APP_BUILD_TYPE "@BUILD_TYPE_STR@"

// Smart version string depending on repo
#ifdef _DEBUG
    #define APP_VERSION_FULL APP_VERSION_STRING " (" APP_GIT_COMMIT " " APP_REPO_TYPE ")"
#else
    #define APP_VERSION_FULL APP_VERSION_STRING
#endif

#endif // VERSION_H
