# Ham Spirit Easter Egg - Deutsche Übersetzung
# Diese Datei enthält Übersetzungen speziell für das Ham Spirit Spiel

# Spielaktivierung
HAMSPIRIT_ACTIVATING=Ham Spirit wird aktiviert...
HAMSPIRIT_WELCOME=Willkommen bei Ham Spirit!
HAMSPIRIT_LOADING=Spielwelt wird geladen...

# Story Einführung
HAMSPIRIT_INTRO_1=Du bist der Ham Spirit, ein positiver Funkspruch, der auf allen Amateurfunkbändern gesendet werden möchte.
HAMSPIRIT_INTRO_2=Doch als Funkspruch stehst du vor Hindernissen, die nur mit geschicktem Einsatz von Mess- und Regeltechnik überwunden werden können.
HAMSPIRIT_INTRO_3=Nutze deinen Antennentuner, Anpassnetzwerke und die Morsekanone, um deine Reise zu vollenden.

# Steuerung
HAMSPIRIT_CONTROLS_TITLE=Spielsteuerung
HAMSPIRIT_CONTROLS_MOVEMENT=Linker Analogstick: Links/Rechts lenken und Geschwindigkeit anpassen
HAMSPIRIT_CONTROLS_TUNER_L=L1/L2: Induktivität verringern/erhöhen
HAMSPIRIT_CONTROLS_TUNER_C=R1/R2: Kapazität verringern/erhöhen
HAMSPIRIT_CONTROLS_UNUN=Steuerkreuz hoch/runter: UnUn Impedanzverhältnis anpassen
HAMSPIRIT_CONTROLS_MORSE_STRAIGHT=Untere runde Taste: Morsekanone (Vertikaltaste)
HAMSPIRIT_CONTROLS_MORSE_PADDLE=Linke/Rechte runde Tasten: Paddle (dit/dah)
HAMSPIRIT_CONTROLS_AIM=Rechter Analogstick: Morsekanone ausrichten
HAMSPIRIT_CONTROLS_PAUSE=Start-Taste: Spiel pausieren
HAMSPIRIT_CONTROLS_SKIP=Beliebige Taste zum Überspringen

# Tastatur Ausweichlösung
HAMSPIRIT_KB_MOVEMENT=Pfeiltasten: Lenken
HAMSPIRIT_KB_SPEED=Bild auf/ab: Geschwindigkeit
HAMSPIRIT_KB_TUNER_L=Q/W: Induktivität
HAMSPIRIT_KB_TUNER_C=E/R: Kapazität
HAMSPIRIT_KB_UNUN=A/S: UnUn Verhältnis
HAMSPIRIT_KB_MORSE=Leertaste: Morsekanone
HAMSPIRIT_KB_AIM=I/J/K/L: Ausrichten
HAMSPIRIT_KB_PAUSE=P: Pause

