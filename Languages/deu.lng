FP_IMP_X=  Blindwiderstand (X): {0} Ohm
FP_IMP_Z_MAG=  Impedanz-Betrag |Z|: {0} Ohm
FP_IMP_PHASE=  Phase: {0} Grad
FP_IMP_SWR=  SWR: {0}
FP_IMP_TYPE_INDUCTIVE=  Blindwiderstand: Induktiv (X > 0)
FP_IMP_TYPE_CAPACITIVE=  Blindwiderstand: Kapazitiv (X < 0)
FP_IMP_TYPE_RESISTIVE=  Blindwiderstand: Resistiv (X ≈ 0)
FP_IMP_HINT_LOW=  Impedanz-Hinweis: Zu niedrig im Vergleich zu 50 Ohm
FP_IMP_HINT_HIGH=  Impedanz-Hinweis: Zu hoch im Vergleich zu 50 Ohm
FP_IMP_HINT_GOOD=  Impedanz-Hinweis: Nahe 50 Ohm

# Anpassungs-Hinweise
MATCH_TITLE=== Anpassungs-Hinweise ===
MATCH_USING_DATA=Verwende Impedanzdaten bei {0} Hz
MATCH_R_X=  Impedanz: {0} + j{1} Ohm
MATCH_HINT_TITLE=Anpassungs-Vorschläge (grobe Orientierung):
MATCH_X_CAPACITIVE=  Blindwiderstand ist KAPAZITIV (X < 0): Serien-INDUKTIVITÄT hinzufügen zum Kompensieren
MATCH_X_INDUCTIVE=  Blindwiderstand ist INDUKTIV (X > 0): Serien-KAPAZITÄT hinzufügen zum Kompensieren
MATCH_X_GOOD=  Blindwiderstand nahe null: Guter Blindwiderstand, Fokus auf Widerstandsanpassung
MATCH_R_LOW=  Widerstand ist NIEDRIG (R < 50 Ohm): L-Glied mit Hochtransformation erwägen
MATCH_R_HIGH=  Widerstand ist HOCH (R > 50 Ohm): L-Glied mit Tiefsetzung erwägen
MATCH_R_GOOD=  Widerstand nahe 50 Ohm: Gute Anpassung
MATCH_DISCLAIMER=Hinweis: Dies sind grobe Richtlinien, keine präzisen Bauteilwerte.\nKonsultieren Sie Antennen-Anpassungs-Referenzen für detailliertes Netzwerk-Design.

# Kabellänge messen
CABLE_LEN_TITLE=== Kabellänge messen ===
CABLE_LEN_INST1=Diese Funktion schätzt die Kabellänge aus der elektrischen Länge.
CABLE_LEN_INST2=Kabel an Port 1 anschliessen. Fernes Ende offen lassen oder kurzschliessen.
CABLE_LEN_INST3=Sweep sollte breiten Frequenzbereich abdecken für beste Genauigkeit.
CABLE_LEN_TERM=Kabel-Abschluss:
CABLE_LEN_OPEN=1. Offen (fernes Ende nicht angeschlossen)
CABLE_LEN_SHORT=2. Kurz (fernes Ende kurzgeschlossen)
CABLE_LEN_SELECT_TYPE=Kabeltyp auswählen:
CABLE_LEN_MANUAL_VF=Manuelle Eingabe:
CABLE_LEN_VF=Verkürzungsfaktor eingeben (0.6-0.95): >
CABLE_LEN_USING_CABLE=Verwende {0} mit VF = {1}
CABLE_LEN_ANALYZING=Analysiere Phasenantwort...
CABLE_LEN_RESULT=Geschätzte Kabellänge: {0} Meter ({1} Fuss)
CABLE_LEN_CONFIDENCE=Konfidenz: {0}%
CABLE_LEN_WARN_FEW_POINTS=Warnung: Zu wenige Messpunkte für zuverlässige Schätzung
CABLE_LEN_WARN_SMALL_SPAN=Warnung: Frequenzbereich zu klein. Breiteren Sweep für bessere Genauigkeit verwenden.
CABLE_LEN_ACCURACY_NOTE=Hinweis zur Messgenauigkeit:
CABLE_LEN_ACCURACY_1=- Typische Genauigkeit: ±10-20% durch VF-Variation und Stecker
CABLE_LEN_ACCURACY_2=- Stecker addieren ~10-30cm äquivalente Länge
CABLE_LEN_ACCURACY_3=- Tatsächlicher Kabel-VF kann um ±5-10% vom Nennwert abweichen
CABLE_LEN_KNOWN_LENGTH=Kennen Sie die tatsächliche Kabellänge?
CABLE_LEN_ENTER_ACTUAL=Tatsächliche Kabellänge in Metern eingeben: >
CABLE_LEN_CORRECTED_VF=Korrigierter VF für dieses Kabel: {0}
CABLE_LEN_VF_NOTE=Original VF: {0}, Gemessen: {1}m, Tatsächlich: {2}m
CABLE_LEN_VF_HINT=Verwenden Sie diesen korrigierten VF für künftige Messungen mit diesem Kabel.
CABLE_LEN_VF_INVALID=Berechneter VF außerhalb des gültigen Bereichs. Messungen überprüfen.
CABLE_LEN_HINT=Hinweis: Für beste Ergebnisse mindestens 50-100 MHz Bereich sweepen.

