# Freeze Punkt Pause Konfiguration
AUDIO_CONFIG_FREEZE_CMD=  F - Freeze Punkt-Pausendauer konfigurieren
FREEZE_PAUSE_CONFIG_TITLE=Freeze Punkt-Pause Konfiguration
FREEZE_PAUSE_CONFIG_CURRENT=Aktuelle Freeze Punkt-Pause: {0} ms
FREEZE_PAUSE_CONFIG_DESC=Die Freeze Punkt-Pause bestimmt die Stille zwischen wiederholten Punkten im Freeze Modus bei punktierter Wiedergabe.\nLängere Pausen bieten mehr Zeit, jede Wiederholung klar zu hören.\nKürzere Pausen erzeugen einen schnelleren Rhythmus.
FREEZE_PAUSE_CONFIG_VALID_RANGE=Gültiger Bereich: 50 - 2000 ms
FREEZE_PAUSE_CONFIG_PROMPT=Freeze Punkt-Pause in Millisekunden eingeben (50-2000), oder ESC zum Abbrechen: >
FREEZE_PAUSE_CONFIG_SET=Freeze Punkt-Pause auf {0} ms gesetzt
FREEZE_PAUSE_CONFIG_APPLIED=Änderung sofort angewendet - kein Neustart erforderlich
FREEZE_PAUSE_CONFIG_ERROR=Fehler: Freeze Punkt-Pause muss zwischen 50 und 2000 ms liegen
AUDIO_HELP_FREEZE=F - Freeze Punkt-Pausendauer konfigurieren (50-2000 ms)
AUDIO_HELP_FREEZE_DESC=    Bestimmt die Pause zwischen wiederholten Punkten im Freeze Modus bei punktierter Wiedergabe

# Web Interface
MENU_WEB_INTERFACE=(I) Web-Interface
MENU_KEY_WEB_INTERFACE=i
WEB_INTERFACE_TITLE=Web-Interface
WEB_INTERFACE_RUNNING=Web-Interface ist AKTIV
WEB_INTERFACE_NOT_RUNNING=Web-Interface ist derzeit AUS
WEB_INTERFACE_URL=Lokaler Zugriff:
WEB_INTERFACE_NETWORK=Netzwerkzugriff:
WEB_INTERFACE_INFO=Sie können jetzt von jedem Browser im lokalen Netzwerk auf das Terminal zugreifen.\nVerwenden Sie diese URL auf Ihrem Smartphone oder Tablet zur Fernsteuerung des Geräts.
WEB_INTERFACE_DESC=Das Web-Interface ermöglicht:\n  - Steuerung der Anwendung über jeden Browser\n  - Nutzung im lokalen Netzwerk (z. B. Smartphone am Antennenmast)\n  - Barrierefreie Bedienung mit Screenreadern\n  - Audioausgabe-Streaming (geplant für zukünftige Version)\n\nSicherheitshinweis: Nur HTTP, nur lokales Netzwerk, keine Authentifizierung.
WEB_INTERFACE_START_PROMPT=Drücken Sie 'S' zum Starten des Web-Interfaces oder ESC zum Zurückkehren:
WEB_INTERFACE_STOP_PROMPT=Drücken Sie 'S' zum Stoppen des Web-Interfaces oder ESC zum Zurückkehren:
WEB_INTERFACE_STARTING=Web-Interface wird gestartet...
WEB_INTERFACE_STOPPING=Web-Interface wird gestoppt...
WEB_INTERFACE_STARTED=Web-Interface erfolgreich gestartet!
WEB_INTERFACE_STOPPED=Web-Interface gestoppt.
WEB_INTERFACE_START_FAILED=Fehler beim Starten des Web-Interfaces. Port könnte bereits belegt sein.
WEB_INTERFACE_READY=Bereit für Browser-Verbindungen.
MSG_PRESS_ANY_KEY=Drücken Sie eine beliebige Taste zum Fortfahren...

