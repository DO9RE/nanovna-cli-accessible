VOLUME_MASTER=Master-Lautstärke (M): {0}%
VOLUME_RULER=Lineal-Lautstärke (R): {0}%
AUDIO_HELP_CURVES=1-5 - Kurvenklang konfigurieren (kontextabhängig):
AUDIO_HELP_CURVES_LIST=      1 = SWR, 2 = Rückflussdämpfung, 3 = Impedanz |Z|
AUDIO_HELP_CURVES_LIST2=      4 = Reaktanz X, 5 = Phase
AUDIO_HELP_SYNTH_MODE=    Im SYNTHESIZER-Modus: Wellenform auswählen (0-5)
