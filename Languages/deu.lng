SMITH_CONFIG_COMMANDS=Befehle:
SMITH_CONFIG_VOLUME_CMD=  V - Lautstärke konfigurieren (10-100%)
SMITH_CONFIG_NOISE_TYPE_CMD=  N - Soundtyp konfigurieren (Rosa/Weiß/Braun/Sinus)
SMITH_CONFIG_PREVIEW_CMD=  P - Vorschau des aktuellen Smith-Sounds
SMITH_CONFIG_PROMPT=Smith-Konfig
SMITH_CONFIG_ENTER_VOLUME=Smith-Hinweise Lautstärke eingeben (10-100%, aktuell: {0}%), oder ESC zum Abbrechen:
SMITH_CONFIG_VOLUME_SET=[Smith-Hinweise Lautstärke gesetzt auf: {0}%]
SMITH_CONFIG_VOLUME_ERROR=[Fehler: Lautstärke muss zwischen 10 und 100 liegen]
SMITH_CONFIG_NOISE_TYPE_MENU=== Soundtyp auswählen ===
SMITH_CONFIG_NOISE_TYPE_1=  1 - Rosa Rauschen (warm, gefiltert - Standard)
SMITH_CONFIG_NOISE_TYPE_2=  2 - Weißes Rauschen (hell, volles Spektrum)
SMITH_CONFIG_NOISE_TYPE_3=  3 - Braunes Rauschen (dunkel, tiefe Frequenzen)
SMITH_CONFIG_NOISE_TYPE_4=  4 - Sinuswelle (reiner Ton, sauberer)
