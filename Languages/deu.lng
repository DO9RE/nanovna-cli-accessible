# Loop Pause Konfiguration
LOOP_PAUSE_CONFIG_TITLE=Loop Pause Konfiguration
LOOP_PAUSE_CONFIG_CURRENT=Aktuelle Loop-Pause: {0} ms
LOOP_PAUSE_CONFIG_DESC=Die Loop-Pause fügt eine konfigurierbare Stille hinzu, bevor der Loop wiederholt wird.\nDies hilft, Iterationen zu trennen und erleichtert das Folgen komplexer Kurven.\nLängere Pausen bieten mehr Atemraum zwischen Loops.
LOOP_PAUSE_CONFIG_VALID_RANGE=Gültiger Bereich: 0 - 5000 ms (0 = keine Pause)
LOOP_PAUSE_CONFIG_PROMPT=Loop-Pause in Millisekunden eingeben (0-5000), oder ESC zum Abbrechen: >
LOOP_PAUSE_CONFIG_SET=Loop-Pause auf {0} ms gesetzt
LOOP_PAUSE_CONFIG_APPLIED=Änderung sofort angewendet - kein Neustart erforderlich
LOOP_PAUSE_CONFIG_ERROR=Fehler: Loop-Pause muss zwischen 0 und 5000 ms liegen
AUDIO_CONFIG_LOOP_PAUSE_CMD=  U - Loop-Pausendauer konfigurieren
AUDIO_HELP_LOOP_PAUSE=U - Loop-Pausendauer konfigurieren (0-5000 ms)
AUDIO_HELP_LOOP_PAUSE_DESC=    Bestimmt die Pause vor Loop-Wiederholung im kontinuierlichen Wiedergabemodus

