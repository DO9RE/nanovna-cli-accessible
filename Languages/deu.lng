# Audio Konfiguration
AUDIO_CONFIG_TITLE=Audio Konfiguration
AUDIO_CONFIG_ENGINE=Aktuelle Engine: {0}
AUDIO_CONFIG_FREQ_RANGE=Frequenzbereich: {0} - {1} Hz
AUDIO_CONFIG_MIDI_MODE_CURRENT=MIDI Abspielmodus: {0}
AUDIO_CONFIG_COMMANDS=Befehle:
