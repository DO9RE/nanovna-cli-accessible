# Hilfe: Kalibrierungsmenü
HELP_CAL_TITLE=== Kalibrierungsmenü Hilfe ===
HELP_CAL_COMMANDS=Verfügbare Befehle:
HELP_CAL_LOAD=  L - Laden         Kalibrierung aus Gerätespeicher laden
HELP_CAL_PERFORM=  P - Durchführen   Kalibrierungs-Assistent starten (Open/Short/Load)
HELP_CAL_HELP=  H - Hilfe         Diese Hilfemeldung anzeigen
HELP_CAL_DESC=Kalibrierung:\n  Die Kalibrierung verbessert die Messgenauigkeit durch Kompensation\n  von Kabel- und Steckereffekten. Der Assistent führt Sie durch:\n  1. Offener Stromkreis (nichts angeschlossen)\n  2. Kurzschluss (Kurzschluss-Kalibrierstandard)\n  3. Last (50 Ohm Last)\n  Die Ergebnisse werden im Gerät für zukünftige Messungen gespeichert.

# Hilfe: Optionsmenü
HELP_OPT_TITLE=== Optionsmenü Hilfe ===
HELP_OPT_COMMANDS=Verfügbare Befehle:
HELP_OPT_LANGUAGE=  L - Sprache       Anzeigesprache auswählen
HELP_OPT_BANDPLAN=  B - Bandplan      Amateurfunk-Bandplan auswählen (IARU-Regionen)
HELP_OPT_HELP=  H - Hilfe         Diese Hilfemeldung anzeigen
HELP_OPT_TIPS=Tipps:\n  - Sprachänderungen wirken sich auf alle Menüs und Meldungen aus\n  - Der Bandplan beeinflusst Komfortfunktionen wie die Bandeignungsprüfung\n  - Einstellungen werden automatisch gespeichert

# Hilfe: Gehe zu Menü (Tabelle)
HELP_GOTO_TITLE=== Gehe zu Menü Hilfe ===
HELP_GOTO_COMMANDS=Verfügbare Befehle:
HELP_GOTO_POINT=  P - Punkt         Zu bestimmtem Punktindex springen
HELP_GOTO_FREQ=  F - Frequenz      Zu nächster Frequenz springen
HELP_GOTO_MIN=  M - Min SWR       Zu Punkt mit minimalem SWR springen
HELP_GOTO_MAX=  X - Max SWR       Zu Punkt mit maximalem SWR springen
HELP_GOTO_HELP=  H - Hilfe         Diese Hilfemeldung anzeigen
HELP_GOTO_CANCEL=  ESC - Abbrechen   Zurück zur Tabellenansicht
HELP_GOTO_TIPS=Tipps:\n  - Punktindex beginnt bei 1\n  - Frequenzsuche findet die nächste Übereinstimmung\n  - Min/Max SWR hilft beim Finden von Resonanz- und Problembereichen

# Hilfe: Gehe zu Menü (Akustisch)
HELP_GOTO_ACOUSTIC_TITLE=== Gehe zu Menü (Akustisch) Hilfe ===
HELP_GOTO_ACOUSTIC_COMMANDS=Verfügbare Befehle:
HELP_GOTO_ACOUSTIC_POINT=  P - Punkt         Zu bestimmtem Punktindex springen
HELP_GOTO_ACOUSTIC_FREQ=  F - Frequenz      Zu nächster Frequenz springen
HELP_GOTO_ACOUSTIC_MIN=  M - Min SWR       Zu Punkt mit minimalem SWR springen
HELP_GOTO_ACOUSTIC_MAX=  X - Max SWR       Zu Punkt mit maximalem SWR springen
HELP_GOTO_ACOUSTIC_CROSS=  C - Kreuzpunkt    Schnittpunkt zwischen zwei Kurven finden
HELP_GOTO_ACOUSTIC_HELP=  H - Hilfe         Diese Hilfemeldung anzeigen
HELP_GOTO_ACOUSTIC_CANCEL=  ESC - Abbrechen   Zurück zur akustischen Analyse
HELP_GOTO_ACOUSTIC_TIPS=Tipps:\n  - Kreuzpunkt hilft beim Finden, wo Impedanz dem Ziel entspricht\n  - Verwenden Sie dies nach dem Springen, um Audio an dieser Position zu hören\n  - Kombinieren Sie mit Schleifenmarkern, um sich auf bestimmte Bereiche zu konzentrieren

# Hilfe: Komfortfunktionen Menü
HELP_COMFORT_TITLE=== Komfortfunktionen Menü Hilfe ===
HELP_COMFORT_DESC=Komfortfunktionen bieten praktische Werkzeuge für Antennen- und Kabelanalyse.
HELP_COMFORT_COMMANDS=Verfügbare Funktionen:
HELP_COMFORT_1=  1 - Bandeignung           Antennenleistung auf Amateurfunkbändern prüfen
HELP_COMFORT_2=  2 - Resonanzfinder        Frequenzen mit minimalem SWR finden
HELP_COMFORT_3=  3 - SWR-Bandbreite        1,5:1 und 2:1 SWR-Bandbreite berechnen
HELP_COMFORT_4=  4 - Fußpunktimpedanz      Detaillierte Impedanz bei gewählter Frequenz
HELP_COMFORT_5=  5 - Anpassungshinweise    Vorschläge zur Impedanzanpassung
HELP_COMFORT_6=  6 - Kabellänge            Kabellänge aus Phase schätzen
HELP_COMFORT_7=  7 - Kabelfehler           Kurzschlüsse, Unterbrechungen und Schäden erkennen
HELP_COMFORT_8=  8 - Kabeldämpfung         Kabelverlust messen (benötigt S21)
HELP_COMFORT_9=  9 - Filter-Schnelltest    Filtercharakteristiken analysieren (benötigt S21)
HELP_COMFORT_10=  10 - Vorher/Nachher       Zwei Messungen vergleichen
HELP_COMFORT_11=  11 - Auto-Marker (A)      Marker automatisch an Schlüsselpunkte setzen
HELP_COMFORT_12=  12 - Konfiguration (C)    Velocity Factor, SWR-Grenzen usw. einstellen
HELP_COMFORT_HELP=  H - Hilfe                 Diese Hilfemeldung anzeigen
HELP_COMFORT_TIPS=Tipps:\n  - Funktionen 1-7 funktionieren mit S11 (Reflexions-)Messungen\n  - Funktionen 8-9 benötigen S21 (Transmissions-)Messungen\n  - Die meisten Funktionen fragen, ob gemessen werden soll, wenn keine Daten verfügbar sind\n  - Konfigurationseinstellungen beeinflussen das Funktionsverhalten

# Hilfe: Spalten anpassen Menü
HELP_CUSTOM_TITLE=== Spalten anpassen Hilfe ===
HELP_CUSTOM_DESC=Passen Sie an, welche Spalten in der Tabellenansicht angezeigt werden.
HELP_CUSTOM_COLUMNS=Verfügbare Spalten:
HELP_CUSTOM_FREQ=  FREQ  - Frequenz in Hz
HELP_CUSTOM_SWR=  SWR   - Stehwellenverhältnis
HELP_CUSTOM_RL=  RL    - Rückflussdämpfung in dB
HELP_CUSTOM_R=  R     - Widerstand (Realimpedanz)
HELP_CUSTOM_X=  X     - Reaktanz (Imaginärimpedanz)
HELP_CUSTOM_Z=  Z     - Impedanzbetrag |Z|
HELP_CUSTOM_PHASE=  PHASE - Phasenwinkel in Grad
HELP_CUSTOM_USAGE=Verwendung:\n  - Spaltennummer (1-7) eingeben, um sie ein-/auszuschalten\n  - Enter drücken, um zur Tabellenansicht zurückzukehren\n  - [X] bedeutet aktiviert, [ ] bedeutet deaktiviert\n  - Änderungen werden automatisch gespeichert

