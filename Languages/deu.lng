MSG_UNKNOWN_COMMAND=Unbekannter Befehl. H für Hilfe drücken.

# Hilfetexte
HELP_CMD_LINE=NanoVNA-CLI-Accessible - Barrierefreie Konsolenanwendung für NanoVNA-H4\n\nVerwendung: nanovna-cli.exe [OPTIONEN]\n\nKommandozeilen-Optionen:\n  -h, --help              Diese Hilfemeldung anzeigen\n  -d                      Debug-Logging aktivieren (Logs im logs/ Verzeichnis)\n  -p, --port PORT         Seriellen Port angeben (z.B. COM4)\n  --baud RATE             Baudrate festlegen (Standard: 9600)\n  --start FREQ            Startfrequenz (z.B. 144M oder 144000000)\n  --end FREQ              Endfrequenz (z.B. 146M oder 146000000)\n  --step FREQ             Frequenzschritt (z.B. 1K oder 1000)\n  --autostart             Messung automatisch beim Start durchführen\n  --no-audio              Audioausgabe deaktivieren\n  --config FILE           Konfigurationsdatei-Pfad angeben (Standard: config/command_templates.cfg)\n\nBeispiele:\n  Interaktiver Modus:\n    nanovna-cli.exe -d\n\n  Direkte Messung:\n    nanovna-cli.exe -d -p COM4 --start 144M --end 146M --step 1K --autostart\n    nanovna-cli.exe -d -p COM4 --start 144000000 --end 146000000 --step 1000 --autostart\n\nKonfiguration:\n  Einstellungen gespeichert in: config/app_settings.cfg\n  Befehlsvorlagen in: config/command_templates.cfg\n  Debug-Logs in: logs/\n  Export-Dateien in: Export/\n\nHauptmenü-Befehle:\n  Drücken Sie 'H' in jedem Bildschirm für kontextsensitive Hilfe.

HELP_MAIN_MENU_TITLE=== Hauptmenü Hilfe ===
HELP_MAIN_MENU_COMMANDS=Verfügbare Befehle:
HELP_MAIN_MENU_CMD_SUMMARY=  Z - Zusammenfassung  Messwert-Zusammenfassung anzeigen (Min/Max/Durchschn. SWR)
HELP_MAIN_MENU_CMD_TABLE=  T - Tabelle          Messdaten in Tabellenformat mit Seitenumbruch anzeigen
HELP_MAIN_MENU_CMD_ACOUSTIC=  A - Akustisch        Akustischen Analysemodus für Audiodarstellung betreten
HELP_MAIN_MENU_CMD_EXPORT=  E - Export           Messdaten in CSV oder TXT Format exportieren
HELP_MAIN_MENU_CMD_LOAD=  L - Laden            Zuvor exportierte Messdaten laden
HELP_MAIN_MENU_CMD_CALIBRATE=  K - Kalibrieren      Kalibrierungsablauf starten (Offen/Kurz/Last)
HELP_MAIN_MENU_CMD_PORT=  P - Port             Seriellen Port auswählen und konfigurieren
HELP_MAIN_MENU_CMD_RANGE=  R - Range            Frequenzbereich festlegen und Scan durchführen
HELP_MAIN_MENU_CMD_DEVICE=  G - Gerät Info      Geräteinformationen und Batteriestatus anzeigen
HELP_MAIN_MENU_CMD_MANUAL=  M - Messung          Manuelle Messung mit aktuellen Einstellungen durchführen
HELP_MAIN_MENU_CMD_HELP=  H - Hilfe            Diese Hilfemeldung anzeigen
HELP_MAIN_MENU_CMD_QUIT=  Q - Quit             Anwendung beenden
HELP_MAIN_MENU_TIPS=Tipps:\n  - Verwenden Sie 'R' um Frequenzbereich vor Messungen festzulegen\n  - Verwenden Sie 'T' dann 'C' um Tabellenspalten anzupassen\n  - Verwenden Sie 'A' für akustische Analyse nach Messungen\n  - Verwenden Sie 'E' zum Exportieren, 'L' zum später Laden\n  - Drücken Sie 'H' in jedem Bildschirm für kontextspezifische Hilfe

HELP_ACOUSTIC_TITLE=== Akustische Analyse Hilfe ===
HELP_ACOUSTIC_PLAYBACK=Wiedergabesteuerung:
HELP_ACOUSTIC_PLAY=  LEERTASTE   Abspielen / Pause (harte Pause - Stille)
HELP_ACOUSTIC_FREEZE=  F           Einfrieren (statisches Audio an aktueller Position)
HELP_ACOUSTIC_STOP=  S           Stoppen und auf Start zurücksetzen
HELP_ACOUSTIC_TOGGLE_MODE=  T           Glatte/gepunktete Wiedergabe umschalten
HELP_ACOUSTIC_TIME=  +/-         Wiedergabezeit erhöhen/verringern (in Sekunden)
HELP_ACOUSTIC_NAVIGATION=Navigation:
HELP_ACOUSTIC_NAV_LR=  Links/Rechts       Bewege ±1 Punkt
HELP_ACOUSTIC_NAV_CTRL=  Strg+Links/Rechts  Bewege ±10 Punkte
HELP_ACOUSTIC_NAV_SHIFT=  Strg+Umsch+L/R     Bewege ±100 Punkte
HELP_ACOUSTIC_LOOP=Loop-Steuerung:
HELP_ACOUSTIC_LOOP_LEFT=  L           Linke Loop-Markierung setzen
HELP_ACOUSTIC_LOOP_RIGHT=  R           Rechte Loop-Markierung setzen
HELP_ACOUSTIC_LOOP_TOGGLE=  O           Loop-Wiedergabe umschalten
HELP_ACOUSTIC_LOOP_ZOOM=  Z           Loop-Zoom umschalten (zentriert Loop in Stereo, wendet volle Zeit auf Loop an)
HELP_ACOUSTIC_CONTINUOUS=  C           Kontinuierliche Wiederholung umschalten
HELP_ACOUSTIC_CURVES=Kurven (1-5: umschalten, Strg+Ziffer: Lautst-, Umsch+Ziffer: Lautst+):
HELP_ACOUSTIC_CURVE1=  1           SWR (Sinuswelle, Stereo-Pan)
HELP_ACOUSTIC_CURVE2=  2           Rückflussdämpfung (Reine Sinuswelle, Stereo-Pan)
HELP_ACOUSTIC_CURVE3=  3           Impedanz |Z| (Dreieckswelle, Stereo-Pan)
HELP_ACOUSTIC_CURVE4=  4           Reaktanz X (Sägezahnwelle, Stereo-Pan)
HELP_ACOUSTIC_CURVE5=  5           Phase (Sinuswelle mit Stereo-Pan)
HELP_ACOUSTIC_AUDIO_CONFIG=Audiokonfiguration:
HELP_ACOUSTIC_AUDIO_Y=  A           Audio-Konfigurationsbildschirm öffnen\n              - Synthesizer/MIDI-Engine umschalten\n              - Frequenzbereich für Synthesizer konfigurieren (R)\n              - MIDI-Instrumente pro Kurve konfigurieren\n              - MIDI-Klänge vorab hören
HELP_ACOUSTIC_OTHER=Sonstiges:
HELP_ACOUSTIC_RULER=  Y           Akustisches Y-Achsen-Lineal abspielen (aufsteigende Skalenreferenz)
HELP_ACOUSTIC_MEASURE=  M           Messung an aktueller Position anzeigen
HELP_ACOUSTIC_EXPORT=  E           Messung exportieren (im Einfriermodus)
HELP_ACOUSTIC_HELP=  H           Diese Hilfemeldung anzeigen
HELP_ACOUSTIC_ESC=  ESC         Zurück zum Hauptmenü
HELP_ACOUSTIC_MODES=Wiedergabemodi:\n  Glatt - Kontinuierliche gleitende Übergaenge zwischen Punkten\n  Gepunktet - Einzelne Punkte in zeitlichen Abständen
HELP_ACOUSTIC_AUDIO_REP=Audio-Darstellung:\n  - Tonhöhe repräsentiert Y-Achsenwert (höhere Tonhöhe = höherer Wert)\n  - Stereo-Panning repräsentiert X-Achsenposition (links nach rechts)\n  - Jede Kurve hat eine einzigartige Wellenform zur Identifikation
HELP_ACOUSTIC_LOOP_ZOOM_MODE=Loop-Zoom-Modus:\n  Wenn mit aktivem Loop aktiviert:\n  - Loop-Abschnitt wird im Stereofeld zentriert\n  - Volle Wiedergabezeit wird auf Loop-Bereich angewendet\n  - Einfacher Panning/Timing in randpositionierten Loops zu hören
HELP_ACOUSTIC_TIPS=Praktische Tipps:\n  - Beginnen Sie mit Glattmodus für Überblick der Frequenzgang\n  - Wechseln Sie zu Punktmodus um Resonanzpunkte präzise zu zählen\n  - Nutzen Sie Loop-Marker um Problembereiche zu fokussieren (z.B. hoher SWR)\n  - Passen Sie Wiedergabezeit an: länger für Details, kürzer für schnellen Überblick\n  - Nutzen Sie Y-Achsen-Lineal (A-Taste) zur Kalibrierung Ihrer Tonhöhen-Wert-Zuordnung\n  - Freeze (F) um exakte Werte bei interessanten Audio-Features zu inspizieren\n  - Reduzieren Sie Kurven-Lautstärken wenn mehrere Kurven schwer unterscheidbar sind\n  - Blindwiderstand-Kurve (4): steigender Ton = induktiv, fallend = kapazitiv

HELP_DEVICE_TITLE=== Gerät Info Hilfe ===
HELP_DEVICE_COMMANDS=Verfügbare Befehle:
HELP_DEVICE_INFO=  I - Info          Geräteinformationen anzeigen
HELP_DEVICE_BATTERY=  B - Batterie      Batteriespannung abfragen und anzeigen
HELP_DEVICE_SHELL=  S - Shell         Debug Shell für direkte Gerätekommunikation öffnen
HELP_DEVICE_HELP=  H - Hilfe         Diese Hilfemeldung anzeigen
HELP_DEVICE_INFO_DESC=Geräteinformationen:\n  Zeigt Firmware-Version, Hardware-Info und Gerätfaehigkeiten an.
HELP_DEVICE_BATTERY_DESC=Batteriestatus:\n  Zeigt aktuelle Batteriespannung des NanoVNA-Geräts an.\n  Hilft, Geräteenergiestatus während Messungen zu überwachen.
HELP_DEVICE_TIPS=Tipps:\n  - Batterie vor langen Messungen prüfen\n  - Niedrige Batterie kann Messgenauigkeit beeinträchtigen\n  - Typische NanoVNA-H4 Spannung: 3.7-4.2V wenn geladen
HELP_DEVICE_SHELL_DESC=Debug Shell:\n  Öffnet eine direkte Kommunikationsshell zum NanoVNA.\n  Ermöglicht das Senden von Rohbefehlen zum Debuggen und Testen.\n  Verwenden Sie Pfeiltasten zur Navigation, Rücktaste zum Löschen. Drücken Sie ESC zum Beenden.

HELP_TABLE_TITLE=== Tabellenansicht Hilfe ===
HELP_TABLE_NAV_COMMANDS=Navigationsbefehle:
HELP_TABLE_SPACE=  LEERTASTE   Nächste Seite
HELP_TABLE_NEXT=  N           Nächste Seite
HELP_TABLE_PREV=  P           Vorherige Seite
HELP_TABLE_CUSTOMIZE=  C           Spalten anpassen (anzeigbare Spalten umschalten)
HELP_TABLE_ESC=  ESC         Zurück zum Hauptmenü
HELP_TABLE_HELP=  H           Diese Hilfemeldung anzeigen
HELP_TABLE_COLUMNS=Tabellenspalten:
HELP_TABLE_COL_INDEX=  Index       Messpunktindex
HELP_TABLE_COL_FREQ=  Freq(Hz)    Frequenz in Hertz
HELP_TABLE_COL_SWR=  SWR         Stehwellenverhältnis
HELP_TABLE_COL_RL=  RL(dB)      Rückflussdämpfung in Dezibel
HELP_TABLE_COL_R=  R           Widerstand (Realteil der Impedanz)
HELP_TABLE_COL_X=  X           Reaktanz (Imaginärteil der Impedanz)
HELP_TABLE_TIPS=Tipps:\n  - Verwenden Sie LEERTASTE oder N um Seiten vorzublättern\n  - Verwenden Sie P um zu vorherigen Seiten zurückzugehen\n  - Drücken Sie G um zu bestimmtem Punkt oder Frequenz zu springen\n  - Drücken Sie C um anzuzeigende Spalten anzupassen\n  - Blenden Sie unnötige Spalten aus um Screenreader-Ausführlichkeit zu reduzieren\n  - Verwenden Sie Gehe zu > Min SWR um Resonanz schnell zu finden

