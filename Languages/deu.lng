# Allgemeine Nachrichten

# Autostart
AUTOSTART_COMPLETE=Autostart: Messung abgeschlossen.

# MIDI Engine Fehlermeldungen
MIDI_ERROR_OPEN_FAILED_FALLBACK=Warnung: MIDI Engine konnte nicht geöffnet werden, verwende Synthesizer als Fallback.
MIDI_ERROR_OPEN_FAILED_KEEPING=Warnung: MIDI Engine konnte nicht geöffnet werden, behalte aktuelle Engine bei.
MIDI_ERROR_PREVIEW_FAILED=Fehler: MIDI Gerät konnte nicht für Vorschau geöffnet werden
MIDI_ERROR_REOPEN_FAILED=Warnung: MIDI Engine konnte nach Vorschau nicht erneut geöffnet werden. Möglicherweise müssen Sie die Audio-Einstellungen neu konfigurieren.

# Allgemeine Meldungen
MSG_AUDIO_DISABLED=Audio deaktiviert.
MSG_UNKNOWN_COMMAND=Unbekannter Befehl. H für Hilfe drücken.

# Hilfetexte
HELP_CMD_LINE=NanoVNA-CLI-Accessible - Barrierefreie Konsolenanwendung für NanoVNA-H4\n\nVerwendung: nanovna-cli.exe [OPTIONEN]\n\nKommandozeilen-Optionen:\n  -h, --help              Diese Hilfemeldung anzeigen\n  -d                      Debug-Logging aktivieren (Logs im logs/ Verzeichnis)\n  -p, --port PORT         Seriellen Port angeben (z.B. COM4)\n  --baud RATE             Baudrate festlegen (Standard: 9600)\n  --start FREQ            Startfrequenz (z.B. 144M oder 144000000)\n  --end FREQ              Endfrequenz (z.B. 146M oder 146000000)\n  --step FREQ             Frequenzschritt (z.B. 1K oder 1000)\n  --autostart             Messung automatisch beim Start durchführen\n  --no-audio              Audioausgabe deaktivieren\n  --config FILE           Konfigurationsdatei-Pfad angeben (Standard: config/command_templates.cfg)\n\nBeispiele:\n  Interaktiver Modus:\n    nanovna-cli.exe -d\n\n  Direkte Messung:\n    nanovna-cli.exe -d -p COM4 --start 144M --end 146M --step 1K --autostart\n    nanovna-cli.exe -d -p COM4 --start 144000000 --end 146000000 --step 1000 --autostart\n\nKonfiguration:\n  Einstellungen gespeichert in: config/app_settings.cfg\n  Befehlsvorlagen in: config/command_templates.cfg\n  Debug-Logs in: logs/\n  Export-Dateien in: Export/\n\nHauptmenü-Befehle:\n  Drücken Sie 'H' in jedem Bildschirm für kontextsensitive Hilfe.





# U-Menu (Komfortfunktionen)
MENU_COMFORT=(U) Komfortfunktionen

# U-Menu Hauptbildschirm
UMENU_TITLE=Komfortfunktionen Menü
UMENU_SUBTITLE=Praktische Messwerkzeuge für Antennen- und Kabelanalyse
