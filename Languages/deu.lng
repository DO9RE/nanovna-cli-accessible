REACTANCE_FX_ERROR_INVALID_NUMBER=  [Fehler: Ungültige Zahl]
REACTANCE_FX_ENTER_MAX_CC=  Maximalen CC-Wert eingeben (0-127, aktuell={0}), oder ESC zum Beibehalten:
