RULER_CONFIG_TITLE=Y-Achsen-Lineal Konfiguration
RULER_CONFIG_SOUND_MODE=Aktueller Sound-Modus: {0}
RULER_CONFIG_CUSTOM_SOUND_SYNTH=Eigener Sound (Synth): {0}
