REACTANCE_FX_LABEL_GLIDING_IND=Gleitender Modus - Induktiv (X>0)
REACTANCE_FX_LABEL_SMOOTH_CAP=Glatter Modus - Kapazitiv (X<0)
REACTANCE_FX_LABEL_SMOOTH_IND=Glatter Modus - Induktiv (X>0)
REACTANCE_FX_LABEL_DOTTED_CAP=Punktierter Modus - Kapazitiv (X<0)
