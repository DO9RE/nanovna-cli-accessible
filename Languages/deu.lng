WAVEFORM_SQUARE=  1 = Rechteck (hart, summender Ton)
WAVEFORM_TRIANGLE=  2 = Dreieck (mild, hohler Ton)
WAVEFORM_SAWTOOTH=  3 = Sägezahn (hell, steigende Obertöne)
WAVEFORM_SAWTOOTH_INV=  4 = Sägezahn Inv (hell, fallende Obertöne)
