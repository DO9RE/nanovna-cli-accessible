REACTANCE_FX_SCALING_SET=  Skalierung gesetzt auf: {0}
REACTANCE_FX_ERROR_RANGE_0_4=  [Fehler: Muss 0-4 sein]
REACTANCE_FX_SAVED=  [Konfiguration gespeichert]
REACTANCE_FX_CANCELLED=\n[Abgebrochen]
REACTANCE_FX_SYNTH_CURRENT=  Aktuell: {0}, Max. Tiefe={1}%, Skalierung={2}
REACTANCE_FX_SYNTH_EFFECTS_LIST=  Verfügbare DSP-Effekttypen:\n    0 = AM Tremolo - periodische Lautstärkeoszillation (Vibration -> Induktivität)\n    1 = Echo/Reverb - verzögerungsbasierter Raumeffekt (raumfüllend -> Kapazität)\n    2 = Ringmodulation - metallische, inharmonische Töne (markanter Klang)\n    3 = Filter Sweep - Tiefpassfilter-Verdunkelung (Kapazitätsladung)\n    4 = Noise Mix - fügt Rauschen proportional zur Reaktanz hinzu\n    5 = Bitcrush - digitale Verzerrung, Auflösungsverlust
REACTANCE_FX_ENTER_EFFECT_TYPE_SYNTH=  Effekttyp-Nummer eingeben (0-5), oder ESC zum Abbrechen:
REACTANCE_FX_EFFECT_SET_SYNTH=  Effekt gesetzt auf: {0}
REACTANCE_FX_ERROR_INVALID_EFFECT_SYNTH=  [Fehler: Ungültiger Effekttyp, muss 0-5 sein]
REACTANCE_FX_ENTER_MAX_DEPTH=  Maximale Effekttiefe in Prozent eingeben (0-100, aktuell={0}), oder ESC zum Beibehalten:
REACTANCE_FX_MAX_DEPTH_SET=  Max. Tiefe gesetzt auf: {0}%
REACTANCE_FX_ERROR_RANGE_0_100=  [Fehler: Muss 0-100 sein]
REACTANCE_FX_DEADZONE_PROMPT=  Totzone in Ohm eingeben (0-100, aktuell={0}):
REACTANCE_FX_DEADZONE_SET=  Totzone gesetzt auf: +/-{0} Ohm
REACTANCE_FX_MAX_PROMPT=  Max. Reaktanz für vollen Effekt in Ohm eingeben (10-1000, aktuell={0}):
