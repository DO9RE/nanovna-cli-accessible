RULER_SOUND_MODE_CUSTOM=Eigener Sound
RULER_MODE_TOGGLED=Lineal Sound-Modus: {0}
RULER_CUSTOM_TITLE=Lineal Eigenen Sound Konfigurieren
RULER_CUSTOM_SYNTH_PROMPT=Wellenform auswählen (0-5): 0=Sinus, 1=Rechteck, 2=Dreieck, 3=Sägezahn, 4=Sägezahn Inv, 5=Puls\nNummer eingeben (0-5), oder ESC zum Abbrechen: >
RULER_CUSTOM_SYNTH_SET=Lineal eigener Sound gesetzt zu: {0}
RULER_CUSTOM_MIDI_GLIDING_PROMPT=MIDI Instrument für Gleitend Modus auswählen (0-127), oder ESC zum Abbrechen: >
RULER_CUSTOM_MIDI_DOTTED_PROMPT=MIDI Instrument für Punktiert Modus auswählen (0-127), oder ESC zum Abbrechen: >
RULER_CUSTOM_MIDI_SET=Lineal eigenes MIDI Instrument gesetzt zu: {0} ({1})
RULER_CUSTOM_ERROR=Fehler: Ungültiger Wert
RULER_DURATION_TITLE=Lineal Blip-Dauer Konfigurieren
RULER_DURATION_DESC=Blip-Dauer steuert die Länge der kürzesten Blips (halbe Integers) im Lineal.\nLängere Blips werden relativ zu dieser Basisdauer berechnet.
RULER_DURATION_PROMPT=Blip-Dauer in Millisekunden eingeben (30-500), oder ESC zum Abbrechen: >
RULER_DURATION_SET=Lineal Blip-Dauer gesetzt zu {0} ms
RULER_DURATION_ERROR=Fehler: Blip-Dauer muss zwischen 30 und 500 ms sein

# Dauer Untermenü
DURATION_CONFIG_TITLE=Dauer Konfiguration
DURATION_CONFIG_POINT_CURRENT=Aktuelle Punktdauer: {0} ms
DURATION_CONFIG_PAUSE_CURRENT=Aktuelle Pausendauer: {0} ms
DURATION_CONFIG_TOTAL_CURRENT=Gesamtdauer pro Punkt: {0} ms
DURATION_CONFIG_COMMANDS=Befehle:
DURATION_CONFIG_POINT_CMD=  P - Punktdauer konfigurieren (30-500 ms)
DURATION_CONFIG_PAUSE_CMD=  U - PaUsendauer konfigurieren (10-500 ms)
DURATION_CONFIG_BACK_CMD=  ESC - Zurück
DURATION_POINT_TITLE=Punktdauer konfigurieren
DURATION_POINT_DESC=Die Punktdauer bestimmt, wie lange jeder Messpunkt im punktierten Abspielmodus hörbar ist.\nLängere Dauern bieten mehr Zeit, jeden Punkt klar zu hören.\nKürzere Dauern ermöglichen schnellere Durchläufe, können aber schwerer zu unterscheiden sein.
DURATION_POINT_VALID_RANGE=Gültiger Bereich: 30 - 500 ms
DURATION_POINT_PROMPT=Punktdauer in Millisekunden eingeben (30-500), oder ESC zum Abbrechen: >
DURATION_POINT_SET=Punktdauer auf {0} ms gesetzt
DURATION_POINT_APPLIED=Änderung sofort angewendet - kein Neustart erforderlich
DURATION_POINT_ERROR=Fehler: Punktdauer muss zwischen 30 und 500 ms liegen
DURATION_PAUSE_TITLE=Pausendauer konfigurieren
DURATION_PAUSE_DESC=Die Pausendauer bestimmt die Stille zwischen Messpunkten im punktierten Abspielmodus.\nLängere Pausen bieten mehr Zeit, Punkte zu unterscheiden.\nKürzere Pausen ermöglichen schnellere Durchläufe.
DURATION_PAUSE_VALID_RANGE=Gültiger Bereich: 10 - 500 ms
DURATION_PAUSE_PROMPT=Pausendauer in Millisekunden eingeben (10-500), oder ESC zum Abbrechen: >
DURATION_PAUSE_SET=Pausendauer auf {0} ms gesetzt
DURATION_PAUSE_APPLIED=Änderung sofort angewendet - kein Neustart erforderlich
DURATION_PAUSE_ERROR=Fehler: Pausendauer muss zwischen 10 und 500 ms liegen
DURATION_CANCELLED=Abgebrochen

