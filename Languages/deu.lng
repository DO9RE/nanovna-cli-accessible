BAND_SUIT_RESULT_TITLE=Band: {0}
BAND_SUIT_CENTER=  SWR bei Bandmitte ({1} Hz): {2}
BAND_SUIT_MIN=  Minimum SWR im Band: {0} bei {1} Hz
BAND_SUIT_RL=  Return Loss bei Bandmitte: {0} dB
BAND_SUIT_BW=  2:1 SWR-Bandbreite: {0} kHz ({1} Hz bis {2} Hz)
BAND_SUIT_PASS=  Ergebnis: BESTANDEN (SWR <= {0})
BAND_SUIT_FAIL=  Ergebnis: NICHT BESTANDEN (SWR > {0})
BAND_SUIT_NO_BW=  Keine 2:1 Bandbreite in diesem Band gefunden
BAND_SUIT_OUT_OF_RANGE=Band {0} liegt ausserhalb des Messbereichs
BAND_SUIT_CHECKING=Prüfe Band: {0}
BAND_SUIT_SKIPPED=  Band {0} übersprungen
BAND_SUIT_MEASURE_FAILED=  Messung für Band {0} fehlgeschlagen

