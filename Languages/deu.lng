ERROR_NO_DATA=Keine Daten verfügbar
HELP_COMMAND=(H)ilfe
BACK_ESC=  ESC - Zurück
CANCELLED=Abgebrochen
ERROR_INVALID_SELECTION=Ungültige Auswahl

