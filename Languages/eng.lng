DURATION_CONFIG_PAUSE_CMD=  U - Configure paUse duration (10-500 ms)
DURATION_CONFIG_BACK_CMD=  ESC - Back
DURATION_POINT_TITLE=Configure Point Duration
DURATION_POINT_DESC=Point duration controls how long each measurement point sounds in dotted playback mode.\nLonger durations provide more time to hear each point clearly.\nShorter durations allow faster sweeps but may be harder to distinguish.
DURATION_POINT_VALID_RANGE=Valid range: 30 - 500 ms
DURATION_POINT_PROMPT=Enter point duration in milliseconds (30-500), or press ESC to cancel: >
DURATION_POINT_SET=Point duration set to {0} ms
DURATION_POINT_APPLIED=Change applied immediately - no restart needed
DURATION_POINT_ERROR=Error: Point duration must be between 30 and 500 ms
DURATION_PAUSE_TITLE=Configure Pause Duration
DURATION_PAUSE_DESC=Pause duration controls the silence between measurement points in dotted playback mode.\nLonger pauses provide more time to distinguish between points.\nShorter pauses allow faster sweeps.
DURATION_PAUSE_VALID_RANGE=Valid range: 10 - 500 ms
DURATION_PAUSE_PROMPT=Enter pause duration in milliseconds (10-500), or press ESC to cancel: >
DURATION_PAUSE_SET=Pause duration set to {0} ms
DURATION_PAUSE_APPLIED=Change applied immediately - no restart needed
DURATION_PAUSE_ERROR=Error: Pause duration must be between 10 and 500 ms
DURATION_CANCELLED=Cancelled

