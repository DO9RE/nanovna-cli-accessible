REACTANCE_FX_STATUS_DISABLED=DISABLED
REACTANCE_FX_DEADZONE_LABEL=  Dead zone: +/-{0} Ohm
REACTANCE_FX_MAX_LABEL=  Max reactance for full effect: {0} Ohm
REACTANCE_FX_MIDI_GLIDING_HEADER=Gliding mode (sustained instruments)
REACTANCE_FX_MIDI_DOTTED_HEADER=Dotted mode (percussive instruments)
REACTANCE_FX_SYNTH_SMOOTH_HEADER=Smooth mode
REACTANCE_FX_SYNTH_DOTTED_HEADER=Dotted mode
REACTANCE_FX_CAPACITIVE_LABEL=Capacitive effect (X<0):
REACTANCE_FX_INDUCTIVE_LABEL=Inductive effect (X>0):
