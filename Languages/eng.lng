REACTANCE_FX_MAX_DEPTH_LABEL=    Max depth: {0}%, Scaling: {1}
REACTANCE_FX_CMD_TOGGLE=  E - Toggle reactance effects ON/OFF
REACTANCE_FX_CMD_DEADZONE=  D - Set dead zone size (Ohms around zero)
REACTANCE_FX_CMD_MAX=  M - Set maximum reactance for full effect (Ohms)
REACTANCE_FX_CMD_GLIDING_CAP=  1 - Configure GLIDING mode: capacitive effect (X<0)
REACTANCE_FX_CMD_GLIDING_IND=  2 - Configure GLIDING mode: inductive effect (X>0)
REACTANCE_FX_CMD_SMOOTH_CAP=  1 - Configure SMOOTH mode: capacitive effect (X<0)
REACTANCE_FX_CMD_SMOOTH_IND=  2 - Configure SMOOTH mode: inductive effect (X>0)
REACTANCE_FX_CMD_DOTTED_CAP=  3 - Configure DOTTED mode: capacitive effect (X<0)
REACTANCE_FX_CMD_DOTTED_IND=  4 - Configure DOTTED mode: inductive effect (X>0)
REACTANCE_FX_CMD_HELP=  H - Help (scaling curve descriptions)
REACTANCE_FX_CMD_BACK=  ESC - Back
REACTANCE_FX_CONFIGURE_HEADING=Configure {0}
REACTANCE_FX_MIDI_CURRENT=  Current: {0}, Max={1}/127, Scaling={2}
REACTANCE_FX_MIDI_EFFECTS_LIST=  Available effect types:\n    0 = Reverb (CC 91) - spatial, room-filling sound\n    1 = Tremolo/Modulation (CC 1) - oscillation, vibration\n    2 = Chorus (CC 93) - widening, thickening\n    3 = Vibrato Depth (CC 77) - pitch oscillation intensity\n    4 = Vibrato Rate (CC 76) - pitch oscillation speed\n    5 = Detune/Celeste (CC 94) - subtle pitch shifting\n    6 = Brightness (CC 74) - timbral/filter change\n    7 = Expression (CC 11) - dynamic volume modulation
REACTANCE_FX_ENTER_EFFECT_TYPE_MIDI=  Enter effect type number (0-7), or ESC to cancel:
REACTANCE_FX_EFFECT_SET_MIDI=  Effect set to: {0}
REACTANCE_FX_ERROR_INVALID_EFFECT_MIDI=  [Error: Invalid effect type, must be 0-7]
