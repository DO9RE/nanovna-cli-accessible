# Ham Spirit Easter Egg - English Translation
# This file contains translations specific to the Ham Spirit game

# Game activation
HAMSPIRIT_ACTIVATING=Activating Ham Spirit...
HAMSPIRIT_WELCOME=Welcome to Ham Spirit!
HAMSPIRIT_LOADING=Loading game world...

# Story intro
HAMSPIRIT_INTRO_1=You are the Ham Spirit, a positive radio signal seeking to travel across all amateur radio bands.
HAMSPIRIT_INTRO_2=But as a signal, you face obstacles that can only be overcome with proper measurement and tuning techniques.
HAMSPIRIT_INTRO_3=Use your antenna tuner, matching networks, and morse cannon to complete your journey.

# Controls
HAMSPIRIT_CONTROLS_TITLE=Game Controls
HAMSPIRIT_CONTROLS_MOVEMENT=Left analog stick: Steer left/right and adjust speed
HAMSPIRIT_CONTROLS_TUNER_L=L1/L2: Decrease/Increase inductance
HAMSPIRIT_CONTROLS_TUNER_C=R1/R2: Decrease/Increase capacitance
HAMSPIRIT_CONTROLS_UNUN=D-pad up/down: Adjust UnUn impedance ratio
HAMSPIRIT_CONTROLS_MORSE_STRAIGHT=Bottom round button: Morse cannon (straight key)
HAMSPIRIT_CONTROLS_MORSE_PADDLE=Left/Right round buttons: Paddle (dit/dah)
HAMSPIRIT_CONTROLS_AIM=Right analog stick: Aim morse cannon
HAMSPIRIT_CONTROLS_PAUSE=Start button: Pause game
HAMSPIRIT_CONTROLS_SKIP=Press any button to skip

# Keyboard fallback
HAMSPIRIT_KB_MOVEMENT=Arrow keys: Steer
HAMSPIRIT_KB_SPEED=PgUp/PgDn: Speed
HAMSPIRIT_KB_TUNER_L=Q/W: Inductance
HAMSPIRIT_KB_TUNER_C=E/R: Capacitance
HAMSPIRIT_KB_UNUN=A/S: UnUn ratio
HAMSPIRIT_KB_MORSE=Space: Morse cannon
HAMSPIRIT_KB_AIM=I/J/K/L: Aim
HAMSPIRIT_KB_PAUSE=P: Pause

